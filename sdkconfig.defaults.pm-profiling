# Diagnostic overlay: ESP-IDF power-management profiling counters.
#
# Not part of release builds. Build and flash with
# ./scripts/flash-pm-profiling.sh, which layers it over the normal defaults
# (ESP_IDF_SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.pm-profiling").
#
# The firmware then logs a `rustmix-wave=pm-profile` summary (time share in
# light sleep / each DFS mode, light-sleep entries and rejections) plus the
# per-lock table every 60 s -- see src/power_profile.rs. Profiling adds a
# small cost to every PM lock and mode switch, so rebuild without this file
# before measuring battery life itself.
CONFIG_PM_PROFILING=y
