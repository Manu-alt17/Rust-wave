# Rustmix Wave Reader preferences
# The Reader creates /RUSTMIX/READER/PREFS.TXT automatically after a change.
# theme: classic | high-contrast
# orientation: portrait | landscape
# font_size: large | xlarge | xxlarge | xxxlarge (smallest to largest)
# book_font: literata | atkinson-hyperlegible
# paragraph_alignment: justified | left | center | right
version=1
theme=classic
orientation=portrait
font_size=xlarge
book_font=literata
paragraph_alignment=justified
show_progress=true
full_screen=false
