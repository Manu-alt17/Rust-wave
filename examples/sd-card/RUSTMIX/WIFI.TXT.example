# Copy this file to /RUSTMIX/WIFI.TXT on the FAT-formatted SD card.
# Edit it locally. Do not commit or share your real password.
#
# This manual file is a fallback. The normal way to add Wi-Fi networks is
# from a phone: Home > Carica (or Settings > Rete) opens the device's own
# hotspot and shows a QR code to join it; the setup page then opens by itself.
# That flow saves up to 8 networks; this file mirrors what it writes.
#
# Networks are numbered ssid1=/password1=, ssid2=/password2=, and so on, and
# are tried in order at boot (with several, those in range first). A single
# unnumbered ssid=/password= pair (as below) is equivalent to ssid1=/password1=.
# timezone: Europe/Rome (default) | America/New_York | UTC
ssid=YOUR_NETWORK
password=YOUR_PASSWORD
timezone=Europe/Rome
ntp_server=pool.ntp.org
